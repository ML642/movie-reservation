{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "build:identity": "tsc -p src/modules/Identity/tsconfig.json",
    "build:engagement": "tsc -p src/modules/Engagement/tsconfig.json",
    "build:reservation": "tsc -p src/modules/reservation/tsconfig.json",
    "build:shared": "tsc -p src/shared/tsconfig.json",
    "build": "npm run build:shared && npm run build:identity && npm run build:engagement && npm run build:reservation",
    "pretest": "npm run build",
    "test": "node --test gateway.test.js && jest --runInBand",
    "start": "npm run build && npm run start:gateway",
    "start:gateway": "node gateway.js",
    "start:identity": "npm run build && node services/identity.js",
    "start:engagement": "npm run build && node services/engagement.js",
    "start:reservation": "npm run build && node services/reservation.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-list-routes": "^1.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "typescript": "^7.0.2"
  }
}
