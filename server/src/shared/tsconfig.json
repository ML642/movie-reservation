{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "../../build/Shared",
    "noEmitOnError": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.fixtures.ts"]
}
